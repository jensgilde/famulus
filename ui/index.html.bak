<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8" />
<title>Famulus</title>
<style>
  :root {
    font-family: "SF Mono", "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px; line-height: 1.6; font-weight: 400;
    -webkit-font-smoothing: antialiased;

    --bg-primary: #000000; --bg-secondary: #080808; --bg-tertiary: #0d0d0d;
    --bg-hover: #141414; --bg-active: #1a1a1a; --bg-input: #0a0a0a;
    --bg-sidebar: #050505; --bg-code: #0c0c0c;

    --text-primary: #e0e0e0; --text-secondary: #a0a0a0;
    --text-muted: #606060; --text-faint: #3a3a3a;

    --accent: #ff69b4; --accent-hover: #ff85c1;
    --accent-muted: rgba(255,105,180,0.12);

    --border: #1a1a1a; --border-hover: #2a2a2a; --border-focus: #333333;
    --surface: #0a0a0a; --surface-hover: #111111;

    --danger: #ff4444; --warning: #ffaa00; --success: #00cc66;
    --radius: 6px; --radius-lg: 10px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg-primary); color: var(--text-primary);
    overflow: hidden; height: 100vh; width: 100vw;
  }
  #app { height: 100vh; width: 100vw; display: flex; flex-direction: column; }

  /* ---- Toolbar ---- */
  .toolbar {
    display: flex; align-items: center; justify-content: space-between;
    height: 36px; padding: 0 12px;
    background: var(--bg-secondary); border-bottom: 1px solid var(--border);
    user-select: none; flex-shrink: 0;
  }
  .toolbar-left, .toolbar-right { display: flex; align-items: center; gap: 8px; }
  .toolbar-title { font-size: 11px; color: var(--text-muted); font-weight: 700; letter-spacing: .06em; margin-left: 2px; }
  .icon-btn {
    background: none; border: 1px solid var(--border); color: var(--text-muted);
    width: 26px; height: 26px; border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 12px;
    transition: all .15s;
  }
  .icon-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* ---- custom select (Provider / Modell), Obsin-Pillenform ---- */
  .model-select { position: relative; user-select: none; font-size: 11px; }
  .model-select-trigger {
    background: var(--bg-tertiary); border: 1px solid var(--border);
    color: var(--text-secondary); font-family: inherit; font-size: 11px;
    padding: 3px 22px 3px 10px; border-radius: 20px; cursor: pointer;
    white-space: nowrap; max-width: 180px; overflow: hidden; text-overflow: ellipsis;
    transition: border-color .2s; position: relative;
  }
  .model-select-trigger::after {
    content: ""; position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    border: 3px solid transparent; border-top-color: var(--text-muted);
  }
  .model-select.open .model-select-trigger, .model-select-trigger:hover {
    border-color: var(--accent); color: var(--text-primary);
  }
  .model-select-dropdown {
    display: none; position: absolute; top: 100%; right: 0; margin-top: 4px;
    background: var(--bg-tertiary); border: 1px solid var(--border-hover);
    border-radius: var(--radius); max-height: 280px; overflow-y: auto;
    z-index: 100; min-width: 200px;
  }
  .model-select.open .model-select-dropdown { display: block; }
  .model-select-option { padding: 6px 10px; cursor: pointer; color: var(--text-secondary); white-space: nowrap; font-size: 11px; }
  .model-select-option:hover, .model-select-option.active { background: var(--accent-muted); color: var(--text-primary); }

  #credits { color: var(--success); font-size: 11px; font-weight: 600; white-space: nowrap; }

  /* ---- Layout ---- */
  .main-content { display: flex; flex: 1; overflow: hidden; }

  .sidebar { width: 240px; background: var(--bg-sidebar); display: flex; flex-direction: column; flex-shrink: 0; transition: width .2s ease, min-width .2s ease, opacity .15s ease; }
  .left-sidebar { border-right: 1px solid var(--border); }
  .right-sidebar { border-left: 1px solid var(--border); }
  .sidebar.collapsed { width: 0; min-width: 0; padding: 0; opacity: 0; overflow: hidden; border: none; }

  .sidebar-header {
    padding: 10px 12px; border-bottom: 1px solid var(--border);
    font-size: 10px; font-weight: 700; letter-spacing: .08em;
    color: var(--text-muted); text-transform: uppercase;
    display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
  }
  .new-chat-btn {
    background: none; border: 1px solid var(--border); color: var(--text-muted);
    width: 22px; height: 22px; border-radius: 4px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 14px;
    transition: all .15s;
  }
  .new-chat-btn:hover { border-color: var(--accent); color: var(--accent); }

  .conversation-list { flex: 1; overflow-y: auto; padding: 4px; }
  .conversation-item {
    padding: 8px 10px; border-radius: var(--radius); cursor: pointer;
    font-size: 12px; color: var(--text-secondary); transition: background .12s;
    margin-bottom: 1px; display: flex; justify-content: space-between; align-items: flex-start;
  }
  .conversation-item:hover { background: var(--bg-hover); }
  .conversation-item.active { background: var(--bg-active); }
  .conv-info { overflow: hidden; flex: 1; min-width: 0; }
  .conv-title { font-size: 12px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .conversation-item.active .conv-title { color: var(--text-primary); font-weight: 600; }
  .conv-date { font-size: 9.5px; color: var(--text-faint); margin-top: 2px; white-space: nowrap; }
  .conversation-item.active .conv-date { color: var(--text-muted); }
  .conv-actions { display: flex; gap: 2px; flex-shrink: 0; margin-left: 4px; }
  .conv-action-btn {
    opacity: 0; font-size: 10px; color: var(--text-faint); transition: all .12s;
    background: none; border: none; cursor: pointer; padding: 2px 3px; border-radius: 3px; flex-shrink: 0;
  }
  .conversation-item:hover .conv-action-btn { opacity: .5; }
  .conv-action-btn:hover { opacity: 1 !important; background: var(--bg-hover); }
  .conv-action-btn.delete:hover { color: var(--danger); background: rgba(255,68,68,.1); }
  .archiv-leer { padding: 12px; font-size: 11px; color: var(--text-faint); text-align: center; }

  /* ---- Chat area ---- */
  .chat-area { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  #messages { flex: 1; overflow-y: auto; padding: 20px 24px; display: flex; flex-direction: column; gap: 20px; }

  .welcome { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: var(--text-muted); text-align: center; }
  .welcome h2 { font-size: 22px; color: var(--text-primary); font-weight: 600; }
  .welcome-logos { display: flex; gap: 14px; margin-bottom: 8px; }
  .welcome-logo { width: 48px; height: 48px; border-radius: var(--radius-lg); background: var(--bg-tertiary); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 22px; }
  .welcome p { font-size: 12px; max-width: 420px; text-align: center; line-height: 1.7; }

  .message { display: flex; gap: 10px; max-width: 88%; }
  .message.user { align-self: flex-end; flex-direction: row-reverse; }
  .message.assistant, .message.fehler { align-self: flex-start; }

  .message-avatar { width: 26px; height: 26px; border-radius: var(--radius); background: var(--bg-tertiary); display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; border: 1px solid var(--border); }
  .message.user .message-avatar { background: var(--accent-muted); border-color: rgba(255,105,180,.25); }

  .message-bubble { padding: 10px 14px; border-radius: var(--radius-lg); font-size: 12.5px; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
  .message.user .message-bubble { background: var(--accent-muted); border: 1px solid rgba(255,105,180,.12); color: var(--text-primary); }
  .message.assistant .message-bubble { background: var(--surface); border: 1px solid var(--border); color: var(--text-primary); }
  .message.fehler .message-bubble { background: var(--surface); border: 1px solid rgba(255,68,68,.3); color: var(--text-primary); }

  /* ---- Agent-Steps-Box ---- */
  .agent-steps-box { padding: 8px 12px; font-size: 11.5px; background: var(--bg-code); border: 1px solid var(--border-hover); border-radius: var(--radius-lg); max-width: 88%; align-self: flex-start; margin-top: -8px; }
  .agent-steps-header { color: var(--accent); font-weight: 600; margin-bottom: 6px; }
  .agent-step-row { cursor: pointer; display: flex; align-items: center; gap: 4px; color: var(--text-muted); font-size: 11.5px; margin-bottom: 2px; }
  .agent-step-row:hover { color: var(--text-secondary); }
  .agent-step-row .step-icon { color: var(--accent); font-size: 11px; }
  .agent-step-detail { margin-left: 18px; margin-top: 3px; }
  .agent-step-detail .label { color: var(--text-faint); font-size: 10px; margin-bottom: 1px; }
  .agent-step-detail pre { background: #000; padding: 4px 8px; border-radius: 3px; font-size: 10.5px; color: var(--text-secondary); overflow-x: auto; margin: 2px 0; max-height: 160px; overflow-y: auto; white-space: pre-wrap; word-break: break-word; }
  .denkt-zeile { margin-top: 4px; color: var(--text-muted); font-size: 11px; font-style: italic; }
  .gedaechtnis-zeile { color: var(--text-faint); font-size: 10.5px; margin-top: 2px; }

  /* ---- Input ---- */
  .input-area { border-top: 1px solid var(--border); padding: 10px 16px 14px; background: var(--bg-secondary); flex-shrink: 0; }
  .input-wrapper { display: flex; gap: 8px; align-items: flex-end; }
  .input-wrapper textarea {
    flex: 1; background: var(--bg-input); border: 1px solid var(--border); border-radius: var(--radius-lg);
    color: var(--text-primary); font-family: inherit; font-size: 12.5px; padding: 10px 14px;
    resize: none; outline: none; transition: border-color .2s; min-height: 40px; max-height: 180px; line-height: 1.5;
  }
  .input-wrapper textarea:focus { border-color: var(--accent); }
  .input-wrapper textarea::placeholder { color: var(--text-faint); }
  .input-wrapper textarea:disabled { opacity: .5; }

  .send-button { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--accent); background: var(--accent); color: #000; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 15px; transition: all .15s; flex-shrink: 0; font-weight: 700; }
  .send-button:hover:not(:disabled) { background: var(--accent-hover); transform: scale(1.05); }
  .send-button:active:not(:disabled) { transform: scale(.95); opacity: .8; }
  .send-button:disabled { opacity: .2; cursor: not-allowed; transform: none; }
  .send-button.stop { border-color: var(--danger); background: var(--danger); color: #fff; }
  .send-button.stop:hover { background: #ff6666; }

  /* ---- Status bar ---- */
  .statusbar { height: 26px; background: var(--bg-secondary); border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 12px; font-size: 10px; color: var(--text-muted); flex-shrink: 0; }
  .statusbar-left { display: flex; align-items: center; gap: 10px; }
  .statusbar-right { display: flex; align-items: center; gap: 12px; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); }
  .status-dot.offline { background: var(--text-faint); }
  .status-dot.denkt { background: var(--accent); animation: pulse 1.5s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }

  /* ---- Fehlerbanner ---- */
  .fehler-banner { background: var(--accent-muted); border-bottom: 1px solid rgba(255,105,180,.15); padding: 6px 14px; font-size: 11px; color: var(--text-secondary); text-align: center; flex-shrink: 0; }

  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--text-faint); }
</style>
</head>
<body>

<div id="app">

  <div id="fehlerBanner" class="fehler-banner" style="display:none;"></div>

  <div class="toolbar">
    <div class="toolbar-left">
      <button class="icon-btn" id="toggleLinks" title="Chats ein-/ausblenden">▶</button>
      <span class="toolbar-title">FAMULUS</span>
    </div>
    <div class="toolbar-right">
      <button class="icon-btn" id="toggleRechts" title="Archiv ein-/ausblenden">◀</button>
      <div class="model-select" id="provider-cs">
        <div class="model-select-trigger" id="provider-trigger">Hyper</div>
        <div class="model-select-dropdown" id="provider-dropdown"></div>
      </div>
      <div class="model-select" id="modell-cs">
        <div class="model-select-trigger" id="modell-trigger">Modelle laden …</div>
        <div class="model-select-dropdown" id="modell-dropdown"></div>
      </div>
      <span class="status-dot" id="konfigDot"></span>
    </div>
  </div>

  <div class="main-content">

    <div class="sidebar left-sidebar collapsed" id="sidebarLinks">
      <div class="sidebar-header">
        <span>Chats</span>
        <button class="new-chat-btn" id="neuerChatBtn" title="Neuer Chat">+</button>
      </div>
      <div class="conversation-list" id="chatListe"></div>
    </div>

    <div class="chat-area">
      <div id="messages"></div>

      <div class="input-area">
        <div class="input-wrapper">
          <textarea id="eingabe" placeholder="Auftrag eingeben … (⏎ senden, ⇧⏎ Zeilenumbruch)" rows="1" autofocus></textarea>
          <button id="senden" class="send-button">↑</button>
        </div>
      </div>
    </div>

    <div class="sidebar right-sidebar collapsed" id="sidebarRechts">
      <div class="sidebar-header">
        <span>Archiv</span>
        <span id="archivAnzahl" style="font-size:9px;color:var(--text-faint);">0</span>
      </div>
      <div class="conversation-list" id="archivListe"></div>
    </div>

  </div>

  <div class="statusbar">
    <div class="statusbar-left">
      <span class="status-dot" id="statusDot"></span>
      <span id="statusText">Bereit</span>
      <span>·</span><span id="nachrichtenAnzahl">0 Nachrichten</span>
      <span>·</span><span id="zustand">lädt …</span>
    </div>
    <div class="statusbar-right">
      <span id="credits">—</span>
    </div>
  </div>

</div>

<script>
const { invoke } = window.__TAURI__.core;
const { listen }  = window.__TAURI__.event;

const STORAGE_KEY = 'famulus-ui-chats';

const messagesEl = document.getElementById('messages');
const eingabe = document.getElementById('eingabe');
const senden = document.getElementById('senden');
const chatListeEl = document.getElementById('chatListe');
const archivListeEl = document.getElementById('archivListe');
const archivAnzahlEl = document.getElementById('archivAnzahl');
const statusDot = document.getElementById('statusDot');
const statusText = document.getElementById('statusText');
const nachrichtenAnzahlEl = document.getElementById('nachrichtenAnzahl');
const zustandEl = document.getElementById('zustand');
const creditsEl = document.getElementById('credits');
const konfigDot = document.getElementById('konfigDot');
const fehlerBanner = document.getElementById('fehlerBanner');

let laeuft = false;
let aktuelleProvider = 'hyper';
let aktuellesModell = '';
let alleModelle = [];
let creditsTimer = null;
let aktuellerAgentSchritte = []; // laufende Werkzeug-Schritte des aktiven Auftrags
let aktuellerDenktText = '';
let aufgeklappteSchritte = new Set();

// ---- Chat-Persistenz (localStorage, wie Obsin UI) ----
function ladeChats() {
  try {
    const r = localStorage.getItem(STORAGE_KEY);
    return r ? JSON.parse(r) : [];
  } catch { return []; }
}
function speichereChats() { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(chats)); } catch {} }

function neuerLeererChat() {
  return { id: crypto.randomUUID(), titel: 'Neuer Chat', nachrichten: [], erstellt: Date.now(), archiviert: false };
}

let chats = ladeChats();
if (chats.length === 0) chats = [neuerLeererChat()];
let aktiverChatId = chats[0].id;

function aktiverChat() { return chats.find(c => c.id === aktiverChatId); }
function aktiveChats() { return chats.filter(c => !c.archiviert); }
function archivierteChats() { return chats.filter(c => c.archiviert); }

function formatDatum(ts) {
  const d = new Date(ts);
  return d.toLocaleDateString('de-DE', {day:'2-digit', month:'2-digit', year:'2-digit'})
    + ' ' + d.toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'});
}

// ---- Sidebar-Toggle ----
document.getElementById('toggleLinks').addEventListener('click', () => {
  const el = document.getElementById('sidebarLinks');
  el.classList.toggle('collapsed');
  document.getElementById('toggleLinks').textContent = el.classList.contains('collapsed') ? '▶' : '◀';
});
document.getElementById('toggleRechts').addEventListener('click', () => {
  const el = document.getElementById('sidebarRechts');
  el.classList.toggle('collapsed');
  document.getElementById('toggleRechts').textContent = el.classList.contains('collapsed') ? '◀' : '▶';
});

// ---- Custom Select (Provider/Modell) ----
function initSelect(csId) {
  const cs = document.getElementById(csId);
  cs.querySelector('.model-select-trigger').addEventListener('click', (e) => {
    e.stopPropagation();
    document.querySelectorAll('.model-select.open').forEach(c => { if (c !== cs) c.classList.remove('open'); });
    cs.classList.toggle('open');
  });
  document.addEventListener('click', () => cs.classList.remove('open'));
}
function fillDropdown(dropdownId, options, selectedValue, onChange) {
  const dropdown = document.getElementById(dropdownId);
  dropdown.innerHTML = '';
  options.forEach(opt => {
    const div = document.createElement('div');
    div.className = 'model-select-option';
    if (opt.value === selectedValue) div.classList.add('active');
    div.textContent = opt.label;
    div.addEventListener('click', () => {
      onChange && onChange(opt.value);
      dropdown.parentElement.classList.remove('open');
    });
    dropdown.appendChild(div);
  });
}
function setTrigger(triggerId, text) { document.getElementById(triggerId).textContent = text; }

const providerOptions = [
  { value: 'hyper', label: 'Hyper' },
  { value: 'openrouter', label: 'OpenRouter' },
];
initSelect('provider-cs');
initSelect('modell-cs');

async function providerWechsel(value) {
  aktuelleProvider = value;
  setTrigger('provider-trigger', providerOptions.find(p => p.value === value)?.label || value);
  await ladeModelleFuerProvider(value);
  if (alleModelle.length > 0) {
    aktuellesModell = alleModelle[0].id;
    setTrigger('modell-trigger', modellName(alleModelle[0]));
  }
  await setzeModell(value, aktuellesModell);
}
fillDropdown('provider-dropdown', providerOptions, aktuelleProvider, providerWechsel);

// Hyper liefert pricing.input/output schon als $ pro 1M Token. OpenRouter
// liefert stattdessen pricing.prompt/completion als $ pro einzelnem Token -
// erst auf dieselbe Einheit hochrechnen, sonst zeigt der Dropdown für jedes
// OpenRouter-Modell nur "$?/$?" (die Felder heißen dort schlicht anders).
function preisProMillion(m) {
  const p = m.pricing || {};
  if (p.input != null || p.output != null) {
    return { ein: p.input, aus: p.output };
  }
  const proToken = (wert) => {
    const zahl = parseFloat(wert);
    return Number.isFinite(zahl) ? (zahl * 1_000_000).toFixed(2) : null;
  };
  return { ein: proToken(p.prompt), aus: proToken(p.completion) };
}

function modellName(m) {
  return m.display_name || m.name || m.id;
}

async function ladeModelleFuerProvider(provider) {
  try {
    alleModelle = await invoke('modelle_liste', { provider });
    const opts = alleModelle.map(m => {
      const preis = preisProMillion(m);
      return {
        value: m.id,
        label: `${modellName(m)} ($${preis.ein ?? '?'}/$${preis.aus ?? '?'} pro 1M)`
      };
    });
    fillDropdown('modell-dropdown', opts, aktuellesModell, async (value) => {
      aktuellesModell = value;
      const m = alleModelle.find(x => x.id === value);
      setTrigger('modell-trigger', modellName(m) || value);
      await setzeModell(aktuelleProvider, value);
    });
  } catch (e) {
    document.getElementById('modell-dropdown').innerHTML = '<div class="model-select-option">Fehler</div>';
    console.error('Modelle:', e);
  }
}

async function setzeModell(provider, model) {
  if (!model) return;
  try {
    const neu = await invoke('setze_modell', { provider, model });
    zustandEl.textContent = neu;
    konfigDot.classList.remove('offline');
    ladeCredits();
  } catch (e) {
    zeigeFehlerBanner('Modellwechsel fehlgeschlagen: ' + e);
  }
}

function zeigeFehlerBanner(text) {
  fehlerBanner.textContent = '⚠️ ' + text;
  fehlerBanner.style.display = 'block';
}

async function ladeCredits() {
  try {
    const c = await invoke('credits');
    creditsEl.textContent = c === 'n/a' ? '—' : c;
  } catch (e) {
    creditsEl.textContent = '—';
  }
}
function starteCreditsTimer() {
  if (creditsTimer) clearInterval(creditsTimer);
  creditsTimer = setInterval(ladeCredits, 30000);
}

// ---- Init ----
invoke('zustand')
  .then(t => {
    zustandEl.textContent = t;
    const parts = t.split(' · ');
    if (parts.length >= 2) { aktuelleProvider = parts[0].trim(); aktuellesModell = parts[1].trim(); }
    const pl = providerOptions.find(p => p.value === aktuelleProvider);
    setTrigger('provider-trigger', pl ? pl.label : aktuelleProvider);
    fillDropdown('provider-dropdown', providerOptions, aktuelleProvider, providerWechsel);
    return ladeModelleFuerProvider(aktuelleProvider);
  })
  .then(() => {
    const m = alleModelle.find(x => x.id === aktuellesModell);
    if (m) setTrigger('modell-trigger', modellName(m));
  })
  .catch(e => {
    zustandEl.textContent = 'Konfiguration fehlerhaft';
    konfigDot.classList.add('offline');
    zeigeFehlerBanner('Konfiguration fehlerhaft: ' + e);
  })
  .finally(() => {
    ladeCredits();
    starteCreditsTimer();
    renderAlles();
  });

// ---- Rendering ----
function renderAlles() {
  renderChatListe();
  renderArchivListe();
  renderMessages();
  renderStatusbar();
}

function chatItem(c, aktiv, aktionen) {
  const div = document.createElement('div');
  div.className = 'conversation-item' + (aktiv ? ' active' : '');
  div.innerHTML = `
    <div class="conv-info">
      <div class="conv-title"></div>
      <div class="conv-date"></div>
    </div>
    <div class="conv-actions"></div>`;
  div.querySelector('.conv-title').textContent = c.titel;
  div.querySelector('.conv-date').textContent = formatDatum(c.erstellt);
  const actions = div.querySelector('.conv-actions');
  aktionen.forEach(([symbol, titel, klasse, fn]) => {
    const btn = document.createElement('button');
    btn.className = 'conv-action-btn' + (klasse ? ' ' + klasse : '');
    btn.title = titel;
    btn.textContent = symbol;
    btn.addEventListener('click', (e) => { e.stopPropagation(); fn(); });
    actions.appendChild(btn);
  });
  return div;
}

function renderChatListe() {
  chatListeEl.innerHTML = '';
  aktiveChats().forEach(c => {
    const item = chatItem(c, c.id === aktiverChatId, [
      ['📥', 'Archivieren', '', () => chatArchivieren(c.id)],
      ['✕', 'Löschen', 'delete', () => chatLoeschen(c.id)],
    ]);
    item.addEventListener('click', () => chatWechseln(c.id));
    chatListeEl.appendChild(item);
  });
}

function renderArchivListe() {
  const archiv = archivierteChats();
  archivAnzahlEl.textContent = archiv.length;
  archivListeEl.innerHTML = '';
  if (archiv.length === 0) {
    archivListeEl.innerHTML = '<div class="archiv-leer">Keine archivierten Chats.<br>Mit 📥 hierher verschieben.</div>';
    return;
  }
  archiv.forEach(c => {
    const item = chatItem(c, false, [
      ['📤', 'Wiederherstellen', '', () => chatWiederherstellen(c.id)],
      ['✕', 'Endgültig löschen', 'delete', () => chatLoeschen(c.id)],
    ]);
    item.addEventListener('click', () => chatWiederherstellen(c.id));
    archivListeEl.appendChild(item);
  });
}

function messageDiv(rolle, avatar, text) {
  const div = document.createElement('div');
  div.className = 'message ' + rolle;
  const av = document.createElement('div');
  av.className = 'message-avatar';
  av.textContent = avatar;
  const bubble = document.createElement('div');
  bubble.className = 'message-bubble';
  bubble.textContent = text;
  div.appendChild(av);
  div.appendChild(bubble);
  return div;
}

function renderMessages() {
  messagesEl.innerHTML = '';
  const chat = aktiverChat();
  if (!chat) return;

  if (chat.nachrichten.length === 0) {
    const w = document.createElement('div');
    w.className = 'welcome';
    w.innerHTML = `
      <div class="welcome-logos">
        <div class="welcome-logo">🗂️</div><div class="welcome-logo">🖥️</div><div class="welcome-logo">📓</div>
      </div>
      <h2>FAMULUS</h2>
      <p>Datei- und Shell-Zugriff · Gedächtnis · Obsidian-Vault</p>
      <p style="color:var(--text-faint);font-size:11px;"></p>`;
    w.querySelector('p:last-child').textContent = zustandEl.textContent;
    messagesEl.appendChild(w);
    return;
  }

  chat.nachrichten.forEach(m => {
    const avatar = m.rolle === 'user' ? '👤' : (m.rolle === 'fehler' ? '⚠️' : '🤖');
    messagesEl.appendChild(messageDiv(m.rolle, avatar, m.inhalt));
  });

  if (laeuft) {
    messagesEl.appendChild(agentSchritteBox());
  }

  messagesEl.scrollTop = messagesEl.scrollHeight;
}

// ---- Agent-Steps-Box: gruppiert werkzeug_aufruf+werkzeug_ergebnis, zeigt denkt/erinnert/gelernt ----
function agentSchritteBox() {
  const box = document.createElement('div');
  box.className = 'agent-steps-box';

  const werkzeugSchritte = aktuellerAgentSchritte.filter(s => s.art === 'werkzeug');
  const header = document.createElement('div');
  header.className = 'agent-steps-header';
  header.textContent = werkzeugSchritte.length > 0
    ? `⚡ Agent — ${werkzeugSchritte.length} Werkzeug${werkzeugSchritte.length !== 1 ? 'e' : ''}`
    : '⚡ Agent';
  box.appendChild(header);

  werkzeugSchritte.forEach((s, i) => {
    const key = i;
    const expanded = aufgeklappteSchritte.has(key);
    const row = document.createElement('div');
    row.className = 'agent-step-row';
    row.innerHTML = `<span class="step-icon">${expanded ? '▾' : '▸'}</span><span style="color:var(--accent);"></span>`;
    row.querySelector('span:last-child').textContent = s.name;
    row.addEventListener('click', () => {
      if (aufgeklappteSchritte.has(key)) aufgeklappteSchritte.delete(key); else aufgeklappteSchritte.add(key);
      renderMessages();
    });
    box.appendChild(row);
    if (expanded) {
      const detail = document.createElement('div');
      detail.className = 'agent-step-detail';
      detail.innerHTML = `<div class="label">Argumente:</div><pre></pre><div class="label">Ergebnis:</div><pre></pre>`;
      const pres = detail.querySelectorAll('pre');
      pres[0].textContent = s.argumente || '';
      pres[1].textContent = s.ergebnis || '…';
      box.appendChild(detail);
    }
  });

  aktuellerAgentSchritte.filter(s => s.art === 'gedaechtnis').forEach(s => {
    const zeile = document.createElement('div');
    zeile.className = 'gedaechtnis-zeile';
    zeile.textContent = s.text;
    box.appendChild(zeile);
  });

  if (aktuellerDenktText) {
    const denkt = document.createElement('div');
    denkt.className = 'denkt-zeile';
    denkt.textContent = aktuellerDenktText;
    box.appendChild(denkt);
  }

  return box;
}

function renderStatusbar() {
  const chat = aktiverChat();
  nachrichtenAnzahlEl.textContent = (chat ? chat.nachrichten.length : 0) + ' Nachrichten';
  statusText.textContent = laeuft
    ? (aktuellerAgentSchritte.some(s => s.art === 'werkzeug')
        ? `Arbeitet (${aktuellerAgentSchritte.filter(s=>s.art==='werkzeug').length} Werkzeuge)`
        : 'Denkt …')
    : 'Bereit';
  statusDot.classList.toggle('denkt', laeuft);
}

// ---- Chat-Aktionen ----
function chatWechseln(id) {
  if (laeuft) return; // laufenden Auftrag nicht mitten im Wechsel verlieren
  aktiverChatId = id;
  aufgeklappteSchritte = new Set();
  renderAlles();
  eingabe.focus();
}

function neuerChat() {
  const c = neuerLeererChat();
  chats.unshift(c);
  aktiverChatId = c.id;
  speichereChats();
  renderAlles();
  eingabe.focus();
}
document.getElementById('neuerChatBtn').addEventListener('click', neuerChat);

function chatArchivieren(id) {
  const c = chats.find(x => x.id === id);
  if (c) c.archiviert = true;
  if (id === aktiverChatId) {
    const rest = aktiveChats();
    if (rest.length > 0) aktiverChatId = rest[0].id;
    else { const n = neuerLeererChat(); chats.unshift(n); aktiverChatId = n.id; }
  }
  speichereChats();
  renderAlles();
}

function chatWiederherstellen(id) {
  const c = chats.find(x => x.id === id);
  if (c) c.archiviert = false;
  aktiverChatId = id;
  document.getElementById('sidebarRechts').classList.remove('collapsed');
  document.getElementById('toggleRechts').textContent = '▶';
  speichereChats();
  renderAlles();
}

function chatLoeschen(id) {
  chats = chats.filter(c => c.id !== id);
  if (chats.length === 0) chats = [neuerLeererChat()];
  if (id === aktiverChatId) {
    const aktiv = aktiveChats();
    aktiverChatId = aktiv.length > 0 ? aktiv[0].id : chats[0].id;
  }
  speichereChats();
  renderAlles();
}

// ---- Auftrag senden ----
function beschaeftigt(an) {
  laeuft = an;
  eingabe.disabled = an;
  senden.classList.toggle('stop', an);
  senden.textContent = an ? '■' : '↑';
  senden.title = an ? 'Abbrechen' : '';
  if (!an) eingabe.focus();
}

async function los() {
  const auftrag = eingabe.value.trim();
  if (!auftrag || laeuft) return;

  const chat = aktiverChat();
  const verlauf = chat.nachrichten
    .filter(m => m.rolle === 'user' || m.rolle === 'assistant')
    .map(m => ({ rolle: m.rolle, inhalt: m.inhalt }));

  chat.nachrichten.push({ rolle: 'user', inhalt: auftrag });
  if (chat.titel === 'Neuer Chat') {
    chat.titel = auftrag.slice(0, 60) + (auftrag.length > 60 ? '…' : '');
  }
  speichereChats();

  eingabe.value = '';
  eingabe.style.height = 'auto';
  aktuellerAgentSchritte = [];
  aktuellerDenktText = '';
  aufgeklappteSchritte = new Set();
  beschaeftigt(true);
  renderAlles();

  try {
    await invoke('starte_auftrag', { auftrag, verlauf });
  } catch (e) {
    chat.nachrichten.push({ rolle: 'fehler', inhalt: 'Start fehlgeschlagen: ' + e });
    speichereChats();
    beschaeftigt(false);
    renderAlles();
  }
}

async function stoppen() {
  try {
    await invoke('stoppe_auftrag');
  } catch (e) {
    console.error('Abbrechen fehlgeschlagen:', e);
  }
}

senden.addEventListener('click', () => laeuft ? stoppen() : los());
eingabe.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey && !laeuft) { e.preventDefault(); los(); }
});
eingabe.addEventListener('input', () => {
  eingabe.style.height = 'auto';
  eingabe.style.height = Math.min(eingabe.scrollHeight, 180) + 'px';
});

// Selbsttest des Ereigniskanals.
listen('famulus-kanaltest', () => invoke('kanal_steht'))
  .then(() => invoke('pruefe_kanal'))
  .catch(e => zeigeFehlerBanner(
    'Das Fenster darf nicht auf Ereignisse lauschen (' + e + '). Prüfe gui/capabilities/default.json.'));

listen('famulus-modell-gewechselt', e => {
  zustandEl.textContent = e.payload.provider + ' · ' + e.payload.model;
  aktuelleProvider = e.payload.provider;
  aktuellesModell = e.payload.model;
  ladeCredits();
});

listen('famulus-ereignis', e => {
  const ev = e.payload;
  const chat = aktiverChat();

  switch (ev.art) {
    case 'gestartet':
      break;
    case 'denkt':
      aktuellerDenktText = ev.text;
      renderMessages();
      renderStatusbar();
      break;
    case 'werkzeug_aufruf':
      aktuellerAgentSchritte.push({ art: 'werkzeug', name: ev.name, argumente: ev.argumente, ergebnis: null });
      aktuellerDenktText = '';
      renderMessages();
      renderStatusbar();
      break;
    case 'werkzeug_ergebnis': {
      const letzter = [...aktuellerAgentSchritte].reverse().find(s => s.art === 'werkzeug' && s.name === ev.name && s.ergebnis === null);
      if (letzter) letzter.ergebnis = ev.ergebnis;
      renderMessages();
      break;
    }
    case 'erinnert':
      aktuellerAgentSchritte.push({ art: 'gedaechtnis', text: `⌾ ${ev.anzahl} Erinnerungen im Kontext` });
      renderMessages();
      break;
    case 'gelernt':
      aktuellerAgentSchritte.push({ art: 'gedaechtnis', text: `✎ ${ev.anzahl} neu gemerkt` });
      renderMessages();
      break;
    case 'fertig':
      chat.nachrichten.push({ rolle: 'assistant', inhalt: ev.antwort });
      speichereChats();
      aktuellerAgentSchritte = [];
      aktuellerDenktText = '';
      beschaeftigt(false);
      renderAlles();
      ladeCredits();
      break;
    case 'abgebrochen':
      chat.nachrichten.push({ rolle: 'fehler', inhalt: ev.fehler });
      speichereChats();
      aktuellerAgentSchritte = [];
      aktuellerDenktText = '';
      beschaeftigt(false);
      renderAlles();
      ladeCredits();
      break;
  }
});

</script>
</body>
</html>
