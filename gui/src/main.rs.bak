// Kein Konsolenfenster unter Windows. Auf Linux wirkungslos, schadet nicht.
#![cfg_attr(not(debug_assertions), windows_subsystem = "windows")]

use famulus_core::agent::Agent;
use famulus_core::config::Config;
use famulus_core::llm::{self, Message};
use famulus_core::ui::{AgentEvent, Ui};
use std::sync::{Arc, LazyLock};
use tauri::{AppHandle, Emitter};

/// Ein HTTP-Client für die ganze Anwendung.
///
/// `reqwest::Client` ist keine dünne Hülle: Jede Instanz macht ihren eigenen
/// Verbindungs-Pool und ihr eigenes TLS-Setup auf. Vorher entstand bei jedem
/// Klick auf "Credits" ein neuer - der Client ist ausdrücklich zum Teilen
/// gebaut, `clone()` ist billig.
static CLIENT: LazyLock<reqwest::Client> = LazyLock::new(reqwest::Client::new);

/// Die Oberfläche für die GUI. Erfüllt dasselbe Trait wie `TerminalUi` -
/// der Agent merkt nicht, ob er im Terminal oder im Fenster läuft.
struct TauriUi {
    app: AppHandle,
}

impl Ui for TauriUi {
    fn ereignis(&self, ereignis: AgentEvent) {
        // Schlägt das Senden fehl (Fenster zu), gibt es niemanden mehr, den
        // es interessiert. Der Auftrag läuft weiter und endet regulär.
        let _ = self.app.emit("famulus-ereignis", ereignis);
    }
}

/// Eine Nachricht aus dem bisherigen Gesprächsverlauf, wie ihn die
/// Oberfläche aus ihrem `localStorage` mitschickt. Nur die sichtbaren Texte,
/// keine Tool-Aufrufe vergangener Züge - Famulus fragt bei jedem neuen
/// Auftrag notfalls einfach erneut nach, statt Tool-Details über Chat-Grenzen
/// hinweg mitzuschleppen.
#[derive(serde::Deserialize)]
struct VerlaufEintrag {
    rolle: String,
    inhalt: String,
}

fn verlauf_zu_nachrichten(verlauf: Vec<VerlaufEintrag>) -> Vec<Message> {
    verlauf
        .into_iter()
        .map(|e| {
            if e.rolle == "user" {
                Message::User(e.inhalt)
            } else {
                Message::Assistant {
                    text: e.inhalt,
                    tool_calls: Vec::new(),
                }
            }
        })
        .collect()
}

/// Startet einen Auftrag. Kehrt sofort zurück - der Fortschritt kommt danach
/// als Ereignisse ins Fenster, damit die Oberfläche nicht einfriert, während
/// das Modell nachdenkt.
///
/// `verlauf` ist die bisherige Unterhaltung des aktiven Chats (leer bei einem
/// neuen Chat) - siehe `VerlaufEintrag`.
#[tauri::command]
fn starte_auftrag(auftrag: String, verlauf: Vec<VerlaufEintrag>, app: AppHandle) {
    tauri::async_runtime::spawn(async move {
        let ui: Arc<dyn Ui> = Arc::new(TauriUi { app: app.clone() });
        let vorherige_nachrichten = verlauf_zu_nachrichten(verlauf);

        let vorbereitung = (|| -> anyhow::Result<(Config, Box<dyn llm::LlmProvider>)> {
            let config = Config::load()?;
            let provider = llm::build_provider(&config)?;
            Ok((config, provider))
        })();

        match vorbereitung {
            Ok((config, provider)) => {
                let agent = Agent::new(config, provider, Arc::clone(&ui));
                // Die Fertig-Meldung schickt der Agent selbst; hier bleibt nur
                // der Fehlerfall zu melden.
                if let Err(e) = agent.run_task(&vorherige_nachrichten, &auftrag).await {
                    ui.ereignis(AgentEvent::Abgebrochen {
                        fehler: format!("{e:#}"),
                    });
                }
            }
            Err(e) => ui.ereignis(AgentEvent::Abgebrochen {
                fehler: format!("{e:#}"),
            }),
        }
    });
}

/// Selbsttest des Ereigniskanals.
///
/// Das Fenster ruft das beim Laden auf; der Kern schickt daraufhin ein
/// Ereignis zurück. Kommt es an, meldet sich das Fenster mit `kanal_steht`.
/// Klingt nach Umstand, hat aber einen konkreten Grund: Tauri 2 erlaubt dem
/// Frontend standardmäßig nichts, und ein fehlendes Lauschrecht sieht von
/// außen exakt aus wie ein hängender Auftrag - das Fenster bleibt einfach
/// leer. Diese zwei Zeilen machen den Unterschied sofort sichtbar.
#[tauri::command]
fn pruefe_kanal(app: AppHandle) {
    let _ = app.emit("famulus-kanaltest", ());
}

#[tauri::command]
fn kanal_steht() {
    eprintln!("[famulus] Ereigniskanal steht - das Fenster empfängt Ereignisse.");
}

/// Zeigt oben im Fenster, womit Famulus gerade arbeitet.
#[tauri::command]
fn zustand() -> Result<String, String> {
    let config = Config::load().map_err(|e| format!("{e:#}"))?;
    Ok(format!(
        "{} · {} · max. {} Schritte",
        config.provider,
        config.model.unwrap_or_else(|| "Standardmodell".to_string()),
        config.max_turns
    ))
}

/// Holt die Credits vom aktuellen Provider.
#[tauri::command]
async fn credits() -> Result<String, String> {
    let config = Config::load().map_err(|e| format!("{e:#}"))?;

    let (url, key_var) = match config.provider.as_str() {
        "hyper" => (
            format!(
                "{}/v1/credits",
                config
                    .base_url
                    .as_deref()
                    .unwrap_or("https://hyper.charm.land")
                    .trim_end_matches('/')
            ),
            config
                .api_key_env
                .clone()
                .unwrap_or_else(|| "HYPER_API_KEY".to_string()),
        ),
        "openrouter" => (
            "https://openrouter.ai/api/v1/credits".to_string(),
            config
                .api_key_env
                .clone()
                .unwrap_or_else(|| "OPENROUTER_API_KEY".to_string()),
        ),
        _ => return Ok("n/a".to_string()),
    };

    let api_key = std::env::var(&key_var).map_err(|_| format!("{key_var} nicht gesetzt"))?;
    let body: serde_json::Value = CLIENT
        .get(&url)
        .bearer_auth(&api_key)
        .send()
        .await
        .map_err(|e| format!("Credits-Anfrage fehlgeschlagen: {e}"))?
        .json()
        .await
        .map_err(|e| format!("Kein JSON: {e}"))?;

    // Hyper meldet den verbleibenden Betrag direkt als "balance". OpenRouters
    // /v1/credits meldet stattdessen Gesamtguthaben und Verbrauch getrennt -
    // das Verbleibende ist die Differenz, nicht eines der beiden Felder.
    let betrag = body["balance"].as_f64().or_else(|| {
        let gesamt = body["data"]["total_credits"].as_f64()?;
        let verbraucht = body["data"]["total_usage"].as_f64().unwrap_or(0.0);
        Some(gesamt - verbraucht)
    });
    Ok(betrag.map_or_else(|| "?".to_string(), |b| format!("${b:.2}")))
}

/// Holt die Liste aller verfügbaren Modelle vom aktuellen Provider.
#[tauri::command]
async fn modelle_liste(provider: String) -> Result<Vec<serde_json::Value>, String> {
    let config = Config::load().map_err(|e| format!("{e:#}"))?;

    let url = match provider.as_str() {
        "hyper" => format!(
            "{}/v1/models",
            config
                .base_url
                .as_deref()
                .unwrap_or("https://hyper.charm.land")
                .trim_end_matches('/')
        ),
        "openrouter" => "https://openrouter.ai/api/v1/models".to_string(),
        other => return Err(format!("Unbekannter Provider '{other}'. Erlaubt: 'hyper', 'openrouter'.")),
    };

    let body: serde_json::Value = CLIENT
        .get(&url)
        .send()
        .await
        .map_err(|e| format!("Modelle-Anfrage fehlgeschlagen: {e}"))?
        .json()
        .await
        .map_err(|e| format!("Modelle-Antwort kein JSON: {e}"))?;
    Ok(body["data"].as_array().cloned().unwrap_or_default())
}

/// Setzt Modell und Provider in der famulus.toml und lädt neu.
#[tauri::command]
async fn setze_modell(provider: String, model: String, app: AppHandle) -> Result<String, String> {
    let config_path = dirs::home_dir()
        .unwrap_or_else(|| std::path::PathBuf::from("."))
        .join(".famulus")
        .join("famulus.toml");

    let raw = std::fs::read_to_string(&config_path)
        .map_err(|e| format!("famulus.toml nicht lesbar: {e}"))?;

    let mut value: toml::Value =
        toml::from_str(&raw).map_err(|e| format!("famulus.toml kein gültiges TOML: {e}"))?;

    if let Some(t) = value.as_table_mut() {
        t.insert("provider".to_string(), toml::Value::String(provider.clone()));
        t.insert("model".to_string(), toml::Value::String(model.clone()));
    }

    let neu = toml::to_string_pretty(&value)
        .map_err(|e| format!("TOML serialisieren fehlgeschlagen: {e}"))?;

    std::fs::write(&config_path, neu)
        .map_err(|e| format!("famulus.toml schreiben fehlgeschlagen: {e}"))?;

    // Zustand im Fenster aktualisieren
    let _ = app.emit(
        "famulus-modell-gewechselt",
        serde_json::json!({ "provider": provider, "model": model }),
    );

    Ok(format!("{provider} · {model}"))
}

fn main() {
    tauri::Builder::default()
        .invoke_handler(tauri::generate_handler![
            starte_auftrag,
            zustand,
            pruefe_kanal,
            kanal_steht,
            credits,
            modelle_liste,
            setze_modell
        ])
        .run(tauri::generate_context!())
        .expect("Famulus-Fenster konnte nicht gestartet werden");
}
