# Kopiere diese Datei nach .env im Projektordner. NIE ins Git-Repo committen.

# Nur nötig, wenn provider = "hyper" in famulus.toml (Charm Hyper).
# Key holst du dir im Dashboard unter https://hyper.charm.land -> beginnt mit "sk-hyper-".
HYPER_API_KEY=

# Nur nötig, wenn provider = "anthropic" in famulus.toml
ANTHROPIC_API_KEY=

# Nur nötig, wenn provider = "grok" in famulus.toml
XAI_API_KEY=
